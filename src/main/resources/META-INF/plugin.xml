<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>dev.gaphunter.ansiblecompanion</id>
    <name>Ansible Companion</name>
    <vendor>Gap Hunter Labs</vendor>
    <!-- Required for the Freemium pricing model JetBrains approved for this
         plugin (Marketplace support ticket #[REDACTED-TICKET], 2026-08-04): "Please
         proceed with preparing the plugin for becoming paid... upload a new
         update with the additional parameters." optional="true" is what
         makes this Freemium rather than fully Paid: the plugin still
         installs and runs with no license at all, only the Pro-tier
         features gate on CheckLicense.isLicensed().
         release-version must share its leading digits with the plugin's
         own version (confirmed by a real, local verifyPlugin failure, not
         guessed): 20261 splits into year 2026 and minor 1, so the plugin
         version moved from semver (0.1.x, same scheme every other plugin
         in this catalog still uses) to 2026.1.0 starting with this
         release, matching JetBrains's own documented example exactly
         (release-version 20241 pairs with plugin version 2024.1.1). Only
         this plugin's version scheme changed; the other 19 plugins are not
         enrolled in Paid or Freemium and keep semver unchanged.
         Do not use a literal double hyphen anywhere in this comment, the
         XML spec forbids it inside comments and patchPluginXml will crash. -->
    <product-descriptor code="[REDACTED-PRODUCT-CODE]" release-date="20260804" release-version="20261" optional="true"/>
    <description><![CDATA[
        <p>Encrypt and decrypt Ansible Vault (1.1/AES256 format) directly in the editor,
        without leaving the IDE and without depending on <code>ansible-vault</code> being
        installed (reimplemented with <code>javax.crypto</code>, verified against the
        official Ansible test suite).</p>
        <p>Select plain text -> <b>Encrypt Selection as Ansible Vault</b>, or a
        <code>$ANSIBLE_VAULT;1.1;AES256</code> block -> <b>Decrypt Ansible Vault Selection</b>.
        Both available from the editor's context menu. The password is never saved or cached.</p>
        <p>FQCN-aware completion for <code>ansible.builtin.*</code> modules and Jinja2
        (<code>{{ }}</code>/<code>{% %}</code>/<code>{# #}</code>) syntax highlighting inside
        Ansible YAML are also available (Ansible Companion Pro).</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.yaml</depends>

    <actions>
        <group id="AnsibleCompanion.VaultActions" text="Ansible Vault" popup="true">
            <action id="AnsibleCompanion.EncryptSelection"
                    class="dev.gaphunter.ansiblecompanion.vault.EncryptSelectionAction"
                    text="Encrypt Selection as Ansible Vault"
                    description="Encrypts the selected text as an Ansible Vault 1.1/AES256 block"/>
            <action id="AnsibleCompanion.DecryptSelection"
                    class="dev.gaphunter.ansiblecompanion.vault.DecryptSelectionAction"
                    text="Decrypt Ansible Vault Selection"
                    description="Decrypts a selected Ansible Vault 1.1/AES256 block"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </group>
    </actions>

    <extensions defaultExtensionNs="com.intellij">
        <fileTypeOverrider implementation="dev.gaphunter.ansiblecompanion.detection.AnsibleFileTypeOverrider"/>
        <completion.contributor language="yaml"
                                 implementationClass="dev.gaphunter.ansiblecompanion.completion.AnsibleModuleCompletionContributor"/>
        <annotator language="yaml"
                   implementationClass="dev.gaphunter.ansiblecompanion.completion.JinjaHighlightingAnnotator"/>
    </extensions>
</idea-plugin>
